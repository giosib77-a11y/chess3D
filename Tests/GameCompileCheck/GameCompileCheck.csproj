<Project Sdk="Microsoft.NET.Sdk">

  <!-- Verification-only project: compiles Assets/Scripts/Game against Unity DLLs without the Editor running. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Chess.Game</AssemblyName>
    <RootNamespace>Chess.Game</RootNamespace>
    <!-- CS0649: [SerializeField] fields are assigned by Unity's serializer, not in code. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <UnityEditorDataDir Condition="'$(UnityEditorDataDir)' == ''">C:\Program Files\Unity\Hub\Editor\6000.6.7f1\Editor\Data</UnityEditorDataDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Game/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(UnityEditorDataDir)\Managed\UnityEngine\UnityEngine.dll" Private="false" />
    <Reference Include="$(UnityEditorDataDir)\Managed\UnityEngine\UnityEngine.*Module.dll" Private="false" />
    <Reference Include="../../Library/ScriptAssemblies/Unity.InputSystem.dll" Private="false" />
    <Reference Include="../../Library/ScriptAssemblies/UnityEngine.UI.dll" Private="false" />
    <Reference Include="../../Library/ScriptAssemblies/Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ChessCore.Build/ChessCore.Build.csproj" />
    <ProjectReference Include="../ChessAI.Build/ChessAI.Build.csproj" />
    <ProjectReference Include="../ChessCampaign.Build/ChessCampaign.Build.csproj" />
  </ItemGroup>

</Project>
